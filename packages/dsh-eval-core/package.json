{
  "name": "@bpc-oss/dsh-eval-core",
  "description": "Read-only eval core for DeepSeek Harness: task cases, workspace isolation, oracles, scorecard/report, and candidate manifests (ported from Bobby eval core)",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpc-oss/dsh-verification.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "homepage": "https://github.com/bpc-oss/dsh-verification",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "eval",
    "oracle",
    "scorecard",
    "benchmark",
    "bobby"
  ],
  "bin": {
    "dsh-eval": "lib/cli.js"
  }
}
